{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "preferredVersions": {
    "php": "8.4",
    "wp": false
  },
  "features": {
    "networking": false
  },
  "landingPage": "/sqlite-lantern.php?table=clients&action=row_view",
  "steps": [
    {
      "step": "writeFiles",
      "writeToPath": "/lantern-source",
      "filesTree": {
        "resource": "git:directory",
        "url": "https://github.com/uaimedna/sqlite-lantern.git",
        "ref": "master",
        "refType": "branch"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php $demoWebRoot = '/wordpress'; $demoDataDirectory = '/lantern-data'; require '/lantern-source/demo/setup.php';"
    }
  ]
}
